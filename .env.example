 # 1. Search API (Required)
 
# Get your API key from https://serpapi.com/
SERPAPI_API_KEY=your_serpapi_api_key_here

# 2. LLM Provider & Model Selection
 
# Supported options: ollama, groq, openai, gemini
LLM_PROVIDER=ollama

# Model name:
# - For Ollama: llama3.2 (default), qwen2.5, mistral, gemma2, phi3
# - For Groq: llama-3.3-70b-versatile, llama-3.1-8b-instant
# - For OpenAI: gpt-4o-mini, gpt-4o
# - For Gemini: gemini-1.5-flash, gemini-1.5-pro
MODEL_NAME=phi3

# Optional Temperature (0 = most deterministic/factual, 0.7 = creative)
MODEL_TEMPERATURE=0.5
 
# 3. Cloud Provider API Keys (Only if NOT using Ollama)
 
# GROQ_API_KEY=your_groq_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
# GOOGLE_API_KEY=your_gemini_api_key_here
